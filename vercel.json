{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": [
          "*.py",
          "like-accs/**",
          "requirements.txt",
          "bot_data.json"
        ]
      }
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/like",
      "dest": "/api/like.py"
    },
    {
      "src": "/api/like",
      "dest": "/api/like.py"
    },
    {
      "src": "/api/set_webhook",
      "dest": "/api/set_webhook.py"
    },
    {
      "src": "/api/delete_webhook",
      "dest": "/api/delete_webhook.py"
    },
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/$",
      "dest": "/static/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/api/webhook.py"
    }
  ],
  "env": {
    "TELEGRAM_BOT_TOKEN": "@telegram_bot_token",
    "SHRINK_API": "@shrink_api",
    "SUPER_ADMINS": "@super_admins",
    "ALLOWED_GROUP_IDS": "@allowed_group_ids",
    "REDIRECT_LINK": "@redirect_link",
    "OWNERS": "@owners"
  }
}
